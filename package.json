{
  "name": "my-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "pregenerate": "node --eval \"import('fs').then(f => f.rmSync('node_modules/.prisma', { recursive: true, force: true })).catch(() => {})\"",
    "generate": "prisma generate",
    "build": "pnpm generate && next build --webpack && node scripts/preserve-manifest.js",
    "start": "next start",
    "lint": "eslint src/lib/auth/auth.config.ts src/middleware.ts src/lib/rate-limiter.ts src/app/api/auth/forgot-password/route.ts src/app/api/auth/reset-password/route.ts src/app/dashboard/login/page.tsx src/app/dashboard/lupa-kata-sandi/page.tsx src/app/dashboard/konfirmasi-reset/page.tsx src/__tests__/api/auth/password-reset.test.ts src/__tests__/rate-limiter.test.ts src/__tests__/lib/middleware/redirect-engine.test.ts src/__tests__/portfolio-detail.test.tsx src/app/chat/page.tsx src/lib/db/prisma.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "db:seed:users": "npx tsx prisma/seed-users.ts",
    "_comment_pages_build": "Note for Windows: pages:build uses @cloudflare/next-on-pages which spawns bash internally. On Windows, run via Git Bash, WSL, or ensure bash.exe is in PATH. Cloudflare Pages CI runs on Linux.",
    "pages:build": "npx @cloudflare/next-on-pages",
    "clean:pages": "node --eval \"import('fs').then(f => { f.rmSync('.next', { recursive: true, force: true }); f.rmSync('.vercel/output', { recursive: true, force: true }); f.rmSync('.next-build-manifest.json', { force: true }); }).catch(() => {})\"",
    "pages:build": "cross-env NODE_ENV=production CF_PAGES=1 NEXT_ON_PAGES=1 pnpm clean:pages && pnpm generate && node scripts/pages-build.js",
    "pages:preview": "npx wrangler pages dev",
    "pages:deploy": "npx wrangler pages deploy .vercel/output/static --project-name dayaberkah"
  },
