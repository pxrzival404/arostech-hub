# ============================================================
# .env.example — TEMPLATE ENVIRONMENT VARIABLES
# ============================================================
# File ini adalah DOKUMENTASI. Berisi placeholder, BUKAN secret asli.
# Aman untuk di-commit ke Git (sudah di-allow di .gitignore).
#
# CARA PAKAI (untuk developer baru):
# 1. Copy file ini:  cp .env.example .env
# 2. Buka file .env di editor
# 3. Ganti semua placeholder dengan nilai asli
# 4. Jangan commit file .env (sudah ada di .gitignore)
# ============================================================

# === NEON POSTGRESQL ===
# Source: https://console.neon.tech → Project → Connect → Connection Details
#
# DATABASE_URL        : Pooled connection (hostname ada "-pooler") → untuk app runtime
# DATABASE_URL_UNPOOLED: Direct connection (hostname TANPA "-pooler") → untuk Prisma migration
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# === NEXTAUTH ===
# NEXTAUTH_SECRET: Generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here
# URL base aplikasi. Development: http://localhost:3000, Production: https://yourdomain.com
NEXTAUTH_URL=http://localhost:3000
# Trust host from X-Forwarded headers (required behind reverse proxy like Caddy)
NEXTAUTH_TRUST_HOST=true

# === RESEND EMAIL ===
# Source: https://resend.com/api-keys (format: re_xxxxxxxx)
RESEND_API_KEY=re_your_resend_api_key
# Email pengirim yang sudah diverifikasi di Resend
RESEND_FROM_EMAIL=noreply@yourdomain.com
# Email tim sales untuk notifikasi RFQ baru masuk
SALES_EMAIL=sales@yourdomain.com
# Webhook secret untuk Resend event verification (optional)
# RESEND_WEBHOOK_SECRET=whsec_your_webhook_secret

# === SANITY CMS ===
# Source: https://sanity.io/manage → Project → Settings → API
SANITY_PROJECT_ID=your_sanity_project_id
SANITY_DATASET=production
# API Token: generate dengan permission "Viewer" untuk read-only
SANITY_API_TOKEN=your_sanity_api_token
# API Write Token: generate dengan permission "Editor" untuk write access
SANITY_API_WRITE_TOKEN=your_sanity_api_write_token

# === SANITY CMS (PUBLIC — Client-side) ===
# These are exposed to the browser (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# ============================================================
# CATATAN TAMBAHAN
# ============================================================
# - Untuk production, JANGAN pakai file .env di server
#   Set env vars via PM2 ecosystem.config.cjs atau systemd EnvironmentFile
# - Arsitektur multi-tenant: semua subdomain pakai Sanity dataset yang sama
#   Subdomain differentiation di-handle via middleware & SpokeProvider
# ============================================================
