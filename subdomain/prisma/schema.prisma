// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")          // Pooled connection (untuk app runtime, via PgBouncer)
  directUrl = env("DATABASE_URL_UNPOOLED") // Direct connection (untuk Prisma migration, bypass PgBouncer)
}

// ===== RFQ System =====

model Client {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  phone          String?
  company        String?
  companyAddress String?
  subdomain      String   @default("pju") // Multi-tenant: which spoke this client belongs to
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  rfqs           RFQ[]

  @@index([email])
  @@index([subdomain])
}

model RFQ {
  id                String      @id @default(cuid())
  clientId          String
  folderName        String
  folderDesc        String?
  status            RFQStatus   @default(DRAFT)
  totalProducts     Int         @default(0)
  submittedAt       DateTime?
  // Company / Client fields for RFQ
  companyName       String?
  companyContactPerson String?
  companyEmail      String?
  companyAddress    String?
  // Shipping fields
  shippingCity      String?
  shippingAddress   String?
  shippingCost      Float?
  // Admin edit fields
  overallDiscount   Float       @default(0) // 0-100, diskon keseluruhan %
  adminNotes        String?
  // Multi-tenant
  subdomain         String      @default("pju") // Which spoke this RFQ belongs to
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  client            Client      @relation(fields: [clientId], references: [id])
  items             RFQItem[]
  reports           RFQReport[]

  @@index([clientId])
  @@index([status])
  @@index([subdomain])
}

model RFQItem {
  id              String  @id @default(cuid())
  rfqId           String
  productName     String
  productSlug     String
  productSerial   String?
  subcategory     String?
  quantity        Int     @default(1)
  // Base price from pricing system
  baseUnitPrice   Float?
  // Admin override fields
  unitPrice       Float?  // Admin override price (if different from base)
  discountPercent Float   @default(0) // 0-100, diskon per item
  customNote      String? // Admin catatan per item
  rfq             RFQ     @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([rfqId])
}

model RFQReport {
  id          String      @id @default(cuid())
  rfqId       String
  reportType  ReportType
  fileUrl     String?
  emailSentAt DateTime?
  createdAt   DateTime    @default(now())
  rfq         RFQ         @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([rfqId])
}

enum RFQStatus {
  DRAFT
  SUBMITTED
  PROCESSING
  QUOTED
  ACCEPTED
  REJECTED
}

enum ReportType {
  ORIGINAL_REQUEST
  PROCESSED_RESULT
}

// ===== Contact / Inbox System =====

model ContactMessage {
  id          String            @id @default(cuid())
  name        String
  email       String
  phone       String?
  subject     String?
  message     String
  status      ContactMessageStatus @default(UNREAD)
  replyBody   String?           // Balasan dari admin
  repliedAt   DateTime?         // Waktu balas
  repliedBy   String?           // User ID admin yang membalas
  subdomain   String            @default("pju") // Which spoke this message belongs to
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([subdomain])
}

enum ContactMessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}

// ===== Comments System =====

model ArticleComment {
  id        String   @id @default(cuid())
  articleId String   // slug artikel
  name      String
  email     String
  content   String
  status    CommentStatus @default(PENDING) // M9: moderation status
  subdomain String   @default("pju") // Which spoke this comment belongs to
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([articleId])
  @@index([createdAt])
  @@index([status])
  @@index([subdomain])
}

enum CommentStatus {
  PENDING   // Menunggu moderasi admin
  APPROVED  // Disetujui — tampil di publik
  REJECTED  // Ditolak / spam
}

// ===== Authentication (NextAuth) =====

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("user") // user | admin
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ===== Pricing System =====

enum PricingScope {
  CATEGORY
  PRODUCT
}

enum PricingType {
  FIXED
  TIERED
}

model ProductPricing {
  id            String       @id @default(cuid())
  scope         PricingScope @default(CATEGORY)
  pricingType   PricingType  @default(FIXED)
  categorySlug  String?      // e.g. "pju-led", "pju-tenaga-surya" (when scope=CATEGORY)
  productSlug   String?      // e.g. "pju-led-40w" (when scope=PRODUCT)
  label         String       // Display name, e.g. "PJU LED" or "PJU LED 40W"
  unitPrice     Float        @default(0) // Fixed price (when pricingType=FIXED)
  installationFee Float      @default(0) // Per unit
  isActive      Boolean      @default(true)
  subdomain     String       @default("pju") // Which spoke this pricing belongs to
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  tiers         PricingTier[]

  @@index([scope, categorySlug])
  @@index([productSlug])
  @@index([subdomain])
}

model PricingTier {
  id              String        @id @default(cuid())
  pricingId       String
  minQuantity     Int           @default(1)
  discountPercent Float         @default(0) // 0-100
  tierPrice       Float?        // Harga langsung per pcs di tier ini (alternatif dari diskon %)
  pricing         ProductPricing @relation(fields: [pricingId], references: [id], onDelete: Cascade)

  @@index([pricingId])
}

// ===== Shipping System =====

model ShippingCost {
  id            String   @id @default(cuid())
  city          String   // e.g. "Surabaya", "Sidoarjo", "Jakarta"
  province      String   @default("Jawa Timur")
  baseCost      Float    @default(0) // Base shipping cost in IDR
  freeThreshold Float?   // Order amount above which shipping is free (null = no free shipping)
  isActive      Boolean  @default(true)
  subdomain     String   @default("pju") // Which spoke this shipping cost belongs to
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([city])
  @@index([subdomain])
}
