{
  "agy-security-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|replace_file_content|write_to_file|multi_replace_file_content|edit_file|write_file|bash|edit|write|multiedit",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/pre-tool-guardrail-agy.js",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node ./scripts/hooks/block-no-verify.js",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "gateguard-fact-force": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|replace_file_content|write_to_file|multi_replace_file_content|edit_file|write_file|bash|edit|write|multiedit",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hooks/gateguard-fact-force.js",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "platform-rule-gates": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/pre-edit-rule-gate.cjs",
        "timeout": 10
      },
      {
        "type": "command",
        "command": "node ./scripts/pre-write-ai-doc-guard.cjs",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "replace_file_content|write_to_file|multi_replace_file_content|edit_file|write_file|edit|write|multiedit",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/pre-edit-rule-gate.cjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node ./scripts/pre-write-ai-doc-guard.cjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "post-edit-tracker": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file|multi_replace_file_content|edit_file|write_file|edit|write|multiedit",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hooks/post-edit-accumulator.js",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "quality-verification-stop": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "node ./scripts/stop-format-typecheck.js",
        "timeout": 60
      }
    ]
  }
}